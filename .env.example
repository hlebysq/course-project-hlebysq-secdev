# Example environment variables
APP_ENV=dev
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/secdev_app
POSTGRES_PASSWORD=password
POSTGRES_USER=postgres
POSTGRES_DB=secdev_app

SQL_DEBUG=false
OUTGOING_TIMEOUT_CONNECT=5.0
OUTGOING_TIMEOUT_READ=5.0
OUTGOING_MAX_RETRIES=2
OUTGOING_MAX_RESPONSE_BYTES=1048576
OUTGOING_MAX_CONN=10
